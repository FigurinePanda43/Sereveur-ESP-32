# Domaine racine (sans https://, sans slash final)
DOMAIN=mondomaine.com

# Cloudflare API
# Créer un token sur https://dash.cloudflare.com/profile/api-tokens
# Permissions requises : Zone > DNS > Edit, Zone > Zone > Read
CLOUDFLARE_API_TOKEN=

# Zone ID du domaine (onglet "Overview" du domaine sur Cloudflare, colonne droite)
CLOUDFLARE_ZONE_ID=

# ID du tunnel Cloudflare (créé dans Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_ID=

# Token du tunnel (affiché lors de la création du tunnel, commence par eyJ...)
CLOUDFLARE_TUNNEL_TOKEN=

# Clé secrète (générer : openssl rand -hex 32)
APP_SECRET_KEY=

# Hash bcrypt du mot de passe admin
# Générer avec : python3 -c "import bcrypt; print(bcrypt.hashpw(b'VotreMotDePasse', bcrypt.gensalt()).decode())"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Durée de session en secondes (défaut : 30 jours = 2592000).
# Plafonnée en dur à 31 jours (2678400) : toute valeur supérieure est ramenée à
# ce plafond, un jeton ne peut jamais rester valable plus d'un mois.
SESSION_MAX_AGE_SECONDS=2592000

# Révocation globale (optionnel) : epoch Unix ; les jetons émis avant cet instant
# sont refusés. Mettre `date +%s` pour déconnecter immédiatement toutes les
# sessions. Vide = aucune révocation. (Changer APP_SECRET_KEY a le même effet.)
AUTH_MIN_ISSUED_AT=

# Protection anti-force brute — premier palier (optionnel).
# Défauts : 10 échecs en 15 min → blocage de l'IP pendant 15 min.
BRUTEFORCE_MAX_ATTEMPTS=10
BRUTEFORCE_WINDOW_MINUTES=15
BRUTEFORCE_BLOCK_MINUTES=15

# Retirer le cookie de session des requêtes proxifiées vers les équipements
# (true/false, défaut true). Empêche un équipement compromis de capter le cookie
# d'administration. À passer à false UNIQUEMENT si un équipement protégé a sa
# propre connexion par cookie sur le domaine du portail (Proxmox, Home Assistant…).
PROXY_STRIP_COOKIES=true

# Base de données
DATABASE_URL=sqlite:////data/devices.db
